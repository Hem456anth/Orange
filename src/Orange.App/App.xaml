<Application
    x:Class="Orange.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Orange accent everywhere WinUI uses the system accent (buttons, toggles, progress). -->
            <Color x:Key="SystemAccentColor">#FF7A00</Color>
            <Color x:Key="SystemAccentColorLight1">#FF9433</Color>
            <Color x:Key="SystemAccentColorLight2">#FFAD66</Color>
            <Color x:Key="SystemAccentColorLight3">#FFC799</Color>
            <Color x:Key="SystemAccentColorDark1">#E06A00</Color>
            <Color x:Key="SystemAccentColorDark2">#B85700</Color>
            <Color x:Key="SystemAccentColorDark3">#8F4400</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
