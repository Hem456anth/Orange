<Application
    x:Class="Orange.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Blue accent everywhere WinUI uses the system accent (buttons, toggles, progress). -->
            <Color x:Key="SystemAccentColor">#0A64E0</Color>
            <Color x:Key="SystemAccentColorLight1">#3D9BFF</Color>
            <Color x:Key="SystemAccentColorLight2">#73B8FF</Color>
            <Color x:Key="SystemAccentColorLight3">#A8D3FF</Color>
            <Color x:Key="SystemAccentColorDark1">#0855C2</Color>
            <Color x:Key="SystemAccentColorDark2">#003FA8</Color>
            <Color x:Key="SystemAccentColorDark3">#002E7A</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
