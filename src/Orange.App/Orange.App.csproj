<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Orange.App</RootNamespace>
    <AssemblyName>Orange</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\orange.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Required even when unpackaged: it generates resources.pri, without which NavigationView, NumberBox, InfoBar, ProgressBar… crash on render. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged + self-contained Windows App SDK: runs from a folder (portable) or the Inno Setup installer, no Store or runtime install needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.0</Version>
    <Company>Orange contributors</Company>
    <Product>Orange</Product>
    <Description>Drag, tap Shift, drop: local file conversion for Windows.</Description>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Ship only the UI languages Orange is translated into (cuts the Windows App SDK resource folders). -->
    <SatelliteResourceLanguages>en;hi;te</SatelliteResourceLanguages>
    <!-- Trimming was tried (CI run 53): it broke the CLI and a WinUI control, so the app ships untrimmed. -->
    <!-- Smaller and faster to start: no debug symbols in the release. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orange.Core\Orange.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
