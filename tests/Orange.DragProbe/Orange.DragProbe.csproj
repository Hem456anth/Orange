<Project Sdk="Microsoft.NET.Sdk">
  <!-- Real-input end-to-end test: drives the actual mouse/keyboard with SendInput, performs OLE drags
       (from its own window and from File Explorer) and checks that Orange's wheel appears and converts. Windows only. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
</Project>
